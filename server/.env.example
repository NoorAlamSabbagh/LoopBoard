NODE_ENV=development
PORT=5000

# MongoDB Atlas — replace USER, PASSWORD, and CLUSTER
# Encode special characters in the password (@ becomes %40, etc.)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/loopboard?retryWrites=true&w=majority
MONGODB_DB_NAME=loopboard

REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=change-me-access-use-a-long-random-string
JWT_REFRESH_SECRET=change-me-refresh-use-a-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7
CLIENT_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads
LOG_LEVEL=info
